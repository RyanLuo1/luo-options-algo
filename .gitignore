# Credentials
.env

# Python
__pycache__/
*.pyc
*.pyo

# macOS
.DS_Store

# Robinhood session cache
*.pickle

# Node
web/node_modules/
web/dist/

# PDF reports
reports/*.pdf

# Local Claude Code config (harness state, not app code)
.claude/settings.local.json

# Quote extracts — data, not code (flat-file extraction output)
data/extracts/

# Private research findings — methodology is public (docs/RANKER_SPEC.md),
# results are not. Only the explanatory README stub is tracked.
docs/private/*
!docs/private/README.md

# personal case-study documents live in docs/private/ (untracked); keep the old path ignored too
docs/POD_SELECTION_CASE_STUDY.md

# Impeccable (design skill) — ephemeral/runtime state and the vendored detector binary.
# Tracked: .claude/skills/impeccable/*.md + reference/, .claude/agents/, PRODUCT.md, .impeccable/config.json, .impeccable/live/config.json
.claude/skills/impeccable/scripts/bin/
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/*.png
.impeccable/review/
.impeccable/questions/
.impeccable/live/sessions/
.impeccable/live/previews/
.impeccable/live/cache/
.impeccable/live/inject-journal.json

# Screener e2e screenshots (web/tests/e2e/*.mjs write here)
web/tests/e2e/out/
